# The scheme picks the engine: postgres:// mysql:// sqlite:// mongodb://
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stayup
JWT_SECRET=changeme
# Admins live in the database. Bootstrap the first one with:
#   npm run create-admin <email> <name> <password>

UI_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# open (default): a sign-up activates the account immediately.
# approval: the account waits in a queue until an admin approves it
#   (GET /ui/users/pending, POST /ui/users/pending/:id/approve|reject).
REGISTRATION_MODE=open
